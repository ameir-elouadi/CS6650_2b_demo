{
  "info": {
    "name": "Product API",
    "description": "Every response code for the Product endpoints in api.yaml. Run in order: the 200 request needs the product created by the first request. The 500 requests send the header X-Simulate-Error: true.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "POST /products/{productId}/details",
      "item": [
        {
          "name": "204 - create product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/products/12345/details",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "products",
                "12345",
                "details"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"product_id\":12345,\"sku\":\"ABC-123-XYZ\",\"manufacturer\":\"Acme Corporation\",\"category_id\":456,\"weight\":1250,\"some_other_id\":789}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "400 - missing required fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
